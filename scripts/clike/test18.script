fn boom(x) {
    error("exploded at x=" + string(x));
}

fn middle(fn_arg) {
    var local_alias = fn_arg;
    local_alias(42);
}

fn make_captured() {
    var cap_alias = boom;
    return fn() {
        cap_alias(99);
    };
}

// Case A: Direct -> Global alias -> Local alias -> Named function
var global_alias = boom;
fn wrapper() {
    global_alias(10);
}
wrapper();

